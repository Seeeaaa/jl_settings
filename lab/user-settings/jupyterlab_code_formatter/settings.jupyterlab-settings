{
    "preferences": {
        "default_formatter": {
            "python": "black",
            "R": "formatR",
            "rust": "rustfmt",
            "c++11": "astyle"
        }
    },
    "black": {
        "line_length": 79,
        "string_normalization": true,
        "magic_trailing_comma": true,
        "preview": false
    },
    "ruff": {
        "args": [
            "line-length = 79"
        ]
    },
    "ruffformat": {
        "args": [
            "line-length = 79"
        ]
    },
    "yapf": {
        "style_config": "google"
    },
    "autopep8": {
        "max_line_length": 79
    },
    "isort": {
        "multi_line_output": 3,
        "include_trailing_comma": true,
        "force_grid_wrap": 0,
        "use_parentheses": true,
        "ensure_newline_before_comments": true,
        "line_length": 79
    },
    "formatR": {
        "indent": 2,
        "arrow": true,
        "wrap": true,
        "width_cutoff": 150
    },
    "styler": {},
    "formatOnSave": false,
    "cacheFormatters": false,
    "astyle": {
        "args": []
    },
    "suppressFormatterErrors": false,
    "suppressFormatterErrorsIFFAutoFormatOnSave": false
}